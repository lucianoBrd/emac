{
  "name": "emac",
  "version": "1.0.0",
  "author": "luciano bdt",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/dev.mjs",
    "build": "ng build && node scripts/finalize-static.mjs",
    "watch": "node scripts/dev.mjs --watch-build",
    "test": "ng test",
    "lint": "eslint . --ext .ts,.html",
    "lint:fix": "eslint . --ext .ts,.html --fix",
    "format": "prettier --write \"**/*.{ts,html,scss,css,js,json,md}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,html,scss,css,js,json,md}\" --ignore-path .gitignore",
    "generate-mpa": "node scripts/finalize-static.mjs",
    "github-build": "npm run build",
    "github-deploy": "npx angular-cli-ghpages --dir=dist/emac/browser --no-silent --no-notfound --repo=https://github.com/lucianoBrd/emac.git --name=\"lucianoBrd\" --email=lucien.burdet@gmail.com",
    "test:seo": "node scripts/verify-seo.mjs",
    "test:pwa": "node scripts/verify-pwa.mjs",
    "test:audio": "node --test scripts/audio-cache.test.mjs",
    "test:cms": "node --test scripts/cms-publication.test.mjs scripts/cms-format.test.mjs",
    "content:generate": "node scripts/generate-content.mjs",
    "postinstall": "npm run content:generate",
    "prebuild": "npm run content:generate",
    "pretest": "npm run content:generate",
    "test:content": "node --test scripts/promotions.test.mjs scripts/emac.test.mjs"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^21.2.17",
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.2.17",
    "@angular/compiler": "^21.2.17",
    "@angular/core": "^21.2.17",
    "@angular/forms": "^21.2.17",
    "@angular/platform-browser": "^21.2.17",
    "@angular/platform-browser-dynamic": "^21.2.17",
    "@angular/platform-server": "^21.2.17",
    "@angular/router": "^21.2.17",
    "@angular/service-worker": "21.2.17",
    "@angular/ssr": "^21.2.17",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "bootstrap": "^5.3.3",
    "bootstrap-scss": "^4.6.1",
    "ng-animate": "^2.0.1",
    "ng-gallery": "^12.0.0",
    "ngx-masonry": "^14.0.1",
    "ngx-owl-carousel-o": "^21.0.0",
    "ngx-toastr": "^19.0.0",
    "rm-ng-device-detection": "^5.0.1",
    "rxjs": "~7.8.0",
    "swiper": "^8.3.1",
    "tslib": "^2.3.0",
    "vanilla-tilt": "^1.8.1",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-eslint/eslint-plugin": "^20.2.0",
    "@angular-eslint/eslint-plugin-template": "^20.2.0",
    "@angular-eslint/template-parser": "^20.2.0",
    "@angular/build": "^21.1.0",
    "@angular/cli": "^21.1.0",
    "@angular/compiler-cli": "^21.1.0",
    "@types/jasmine": "~5.1.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.34.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-prettier": "^5.5.4",
    "jasmine-core": "~5.5.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2",
    "yaml": "^2.8.3"
  }
}
